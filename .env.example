# Exemplos demonstrativos. Gere segredos exclusivos antes de iniciar o Compose.
NODE_ENV=development
MYSQL_DATABASE=torque
MYSQL_USER=torque_app
MYSQL_PASSWORD=replace_with_a_unique_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_unique_root_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
API_PORT=3000
HTTP_PORT=8080
